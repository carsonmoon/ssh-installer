#!/usr/bin/env bash
set -e

INSTALL_DIR="/usr/local/3proxy"
CONFIG_FILE="${INSTALL_DIR}/3proxy.cfg"
CSV_FILE="/root/socks5_list.csv"
TXT_FILE="/root/socks5_list.txt"

echo "=================================="
echo "3proxy 多IP SOCKS5代理池安装"
echo "=================================="

if [ "$(id -u)" != "0" ]; then
    echo "请使用 root 用户运行"
    exit 1
fi

# 1. 安装依赖
apt update
DEBIAN_FRONTEND=noninteractive apt install -y git gcc g++ make build-essential libssl-dev zlib1g-dev curl wget

# 2. 下载源码
cd /tmp
rm -rf 3proxy*
git clone https://github.com/z3APA3A/3proxy.git
cd 3proxy

# 3. 编译
make -f Makefile.Linux
mkdir -p "${INSTALL_DIR}"
cp bin/3proxy "${INSTALL_DIR}/"
chmod +x "${INSTALL_DIR}/3proxy"

# 4. 获取出口 IP
echo "[*] 正在获取服务器公网 IPv4..."
IP_LIST=($(ip -4 addr show scope global | grep -oP '(?<=inet\s)\d+(\.\d+){3}'))

echo "发现以下 IP："
for idx in "${!IP_LIST[@]}"; do echo "$((idx+1))) ${IP_LIST[$idx]}"; done

echo
read -p "请输入要生成 SOCKS5 节点的IP序号，逗号分隔（默认全部）: " SELECTED
if [[ -n "$SELECTED" ]]; then
    TMP_LIST=()
    IFS=',' read -ra INDICES <<< "$SELECTED"
    for idx in "${INDICES[@]}"; do
        TMP_LIST+=("${IP_LIST[$((idx-1))]}")
    done
    IP_LIST=("${TMP_LIST[@]}")
fi

# 5. 获取端口和认证设置
read -p "起始端口 [默认10000]: " START_PORT
START_PORT=${START_PORT:-10000}

read -p "用户名生成方式 [1=统一, 2=随机]: " USER_TYPE
USER_TYPE=${USER_TYPE:-1}

if [ "$USER_TYPE" = "1" ]; then
    read -p "统一用户名 [默认admin]: " USERNAME
    USERNAME=${USERNAME:-admin}
    read -s -p "统一密码 [默认123456]: " PASSWORD
    echo
    PASSWORD=${PASSWORD:-123456}
fi

# 6. 生成配置文件
echo "[*] 生成 3proxy 配置..."
mkdir -p "${INSTALL_DIR}"
echo "# 3proxy 多IP SOCKS5代理池" > "${CONFIG_FILE}"
echo "nserver 8.8.8.8" >> "${CONFIG_FILE}"
echo "nserver 1.1.1.1" >> "${CONFIG_FILE}"
echo "timeouts 1 5 30 60 180 1800 15 60" >> "${CONFIG_FILE}"
echo "auth strong" >> "${CONFIG_FILE}"

# 写一次统一或随机用户
> "$CSV_FILE"
> "$TXT_FILE"

PORT=$START_PORT
for IP in "${IP_LIST[@]}"; do
    if [ "$USER_TYPE" = "1" ]; then
        U=$USERNAME
        P=$PASSWORD
    else
        U="user$((RANDOM%10000))"
        P="pass$((RANDOM%100000))"
    fi
    echo "users ${U}:CL:${P}" >> "${CONFIG_FILE}"
    echo "allow ${U}" >> "${CONFIG_FILE}"
    echo "socks -p${PORT} -e${IP}" >> "${CONFIG_FILE}"

    # 写入账号列表
    echo "${IP},${PORT},${U},${P}" >> "$CSV_FILE"
    echo "socks5://${U}:${P}@${IP}:${PORT}" >> "$TXT_FILE"

    PORT=$((PORT+1))
done

# flush 一次即可
echo "flush" >> "${CONFIG_FILE}"

# 7. 创建 systemd 服务
echo "[*] 创建 systemd 服务..."
cat > /etc/systemd/system/3proxy.service <<EOF
[Unit]
Description=3proxy Proxy Server
After=network.target

[Service]
Type=simple
ExecStart=${INSTALL_DIR}/3proxy ${CONFIG_FILE}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable 3proxy
systemctl restart 3proxy

# 8. 防火墙一次性放行端口
END_PORT=$((START_PORT + ${#IP_LIST[@]} - 1))
if command -v ufw >/dev/null 2>&1; then
    ufw allow ${START_PORT}:${END_PORT}/tcp || true
fi
if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port=${START_PORT}:${END_PORT}/tcp || true
    firewall-cmd --reload || true
fi

echo
echo "=================================="
echo "安装完成！"
echo "3proxy 运行状态:"
systemctl --no-pager status 3proxy | head -n 10
echo
echo "生成的账号列表:"
echo "CSV 文件: $CSV_FILE"
echo "SOCKS5 URI 文件: $TXT_FILE"
echo
echo "监听端口:"
ss -lntp | grep 3proxy || echo "未发现监听端口"
